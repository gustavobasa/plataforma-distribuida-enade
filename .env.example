# Copie para .env e troque TODOS os valores "trocar-*" (ou rode scripts/gerar-env.ps1 / scripts/gerar-env.sh,
# que gera senhas aleatórias). O arquivo .env é ignorado pelo Git (RNF08).

# Kerberos
KDC_MASTER_PASSWORD=trocar-kdc-master

# LDAP (administração e usuários de TESTE sintéticos)
LDAP_ADMIN_PASSWORD=trocar-ldap-admin
LDAP_CONFIG_PASSWORD=trocar-ldap-config
LDAP_READONLY_PASSWORD=trocar-ldap-readonly
LDAP_SENHA_ESTUDANTES=trocar-senha-estudantes
LDAP_SENHA_PROFESSORES=trocar-senha-professores

# Elasticsearch (usuário elastic: usado apenas pelo job de bootstrap es-setup)
ELASTIC_PASSWORD=trocar-elastic

# Redis
REDIS_PASSWORD=trocar-redis

# Kafka
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
KAFKA_TOPIC_QUESTOES=enade.questoes.v1
KAFKA_TOPIC_DLQ=enade.questoes.dlq
KAFKA_GROUP_INDEXER=enade-indexer

# API
SESSION_TTL_SECONDS=3600
CACHE_TTL_SECONDS=300

# Conversão de figuras com LLM (RF04, opcional): chave da API da Anthropic. Deixe vazio para não usar.
# Usada só pelo job ingestor. Nunca versione o .env.
ANTHROPIC_API_KEY=
