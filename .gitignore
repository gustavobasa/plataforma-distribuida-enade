# Segredos e credenciais (RNF08)
.env
*.env.local
*.keytab
*.key
*.pem
*.p12
*.jks
secrets/
codigo/infra/**/secrets/

# Dados volumosos / redistribuição
dados/pdfs/
dados/extraidos/
dados/cache/
documento/*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# Saídas temporárias
tmp/
*.log
!evidencias/**/*.log
.DS_Store
Thumbs.db

# Exceção: certificado PÚBLICO da CA intermediária do INEP/RNP (não é segredo; necessário para validar TLS)
!codigo/infra/certs/*.pem
relatorio/*.aux
relatorio/*.log
relatorio/*.bbl
relatorio/*.blg
relatorio/*.out
